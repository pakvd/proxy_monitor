# Пароль веб-панели. Пусто — панель открыта, так можно только на localhost.
MONITOR_PASSWORD=

# С каких адресов можно открыть панель. Через запятую: IP или сеть.
# Пример: 203.0.113.10,10.8.0.0/24
# Пусто — пускает отовсюду.
MONITOR_ALLOWLIST=

# В Docker панель слушает HTTPS на порту 8080. 0 возвращает обычный HTTP.
MONITOR_HTTPS=1

# IP и DNS-имя сервера для сертификата, через запятую.
# Пример: 203.0.113.50,panel.example
MONITOR_TLS_NAMES=

# 1 — cookie сессии только по HTTPS.
MONITOR_COOKIE_SECURE=1

# Ключ, которым шифруются пароли прокси в базе. Это не пароль входа в панель.
# Пусто — ключ будет создан в data/.proxy-key.
MONITOR_SECRET=

# Каталог базы.
DATA_DIR=./data
